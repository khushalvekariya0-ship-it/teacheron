# ─────────────────────────────────────────────────────────────────────────────
# TutorLink — environment variables (copy to .env.local, or set them in your host, e.g. Vercel)
#
#   • Only NEXT_PUBLIC_* values reach the browser. The Supabase URL and the anon / publishable key
#     are public by design: every table has Row Level Security on with no policies, so that key
#     can't read or write any data — only the server can (through SUPABASE_DB_URL).
#   • SUPABASE_SERVICE_ROLE_KEY and SUPABASE_DB_URL are secrets: server only, never NEXT_PUBLIC_.
#   • Step-by-step: docs/SUPABASE_SETUP.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ────────────────────────────────────────────────────────────────
# Supabase → Project Settings → API. The URL looks like https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The anon key (legacy JWT) or the newer publishable key (sb_publishable_…). Public.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The service_role key (legacy JWT) or a secret key (sb_secret_…). SECRET — server only.
# Used for file storage (signed upload/download links) and deleting a sign-in when an account is deleted.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase → Connect → "Transaction pooler" (port 6543), with your database password filled in:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# SECRET — server only. Used by the API and by `npm run db:migrate` / `npm run db:make-admin`.
SUPABASE_DB_URL=
# The public address of the site, without a trailing slash. Links in emails point here, and it must
# also be set as the Site URL in Supabase → Authentication → URL Configuration.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Optional ────────────────────────────────────────────────────────────────
# Connections per server instance to the pooler (default 3).
DATABASE_POOL_MAX=3
# Emails from the site: parental consent for 13–17 students and email copies of notifications
# (Supabase Auth sends its own sign-up and reset emails).
# Create an API key at https://resend.com and verify your sending domain there.
RESEND_API_KEY=
EMAIL_FROM="TutorLink <no-reply@your-domain.com>"
# Protects GET /api/cron (booking lifecycle jobs). Vercel Cron sends it automatically when set.
CRON_SECRET=
