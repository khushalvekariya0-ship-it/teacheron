# ─────────────────────────────────────────────────────────────────────────────
# TutorLink — environment variables
#
# The preview build needs NONE of these (it runs on sample data in the browser).
# Only NEXT_PUBLIC_SITE_URL is read today (src/lib/site.ts).
#
# Rules
#   • Only variables prefixed NEXT_PUBLIC_ reach the browser. They must be publishable,
#     restricted or search-only keys — never secrets.
#   • Everything else is server-only: set it in Vercel (web) and AWS Secrets Manager (API/workers).
#   • Copy to .env.local (web) or apps/api/.env (API) for local development. Never commit real values.
#   • Money is always integer cents; time zones are IANA names.
# ─────────────────────────────────────────────────────────────────────────────

# ── Web app (Next.js on Vercel) ──────────────────────────────────────────────
# Canonical site origin (metadata, sitemaps, emails, OAuth/Stripe return URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# REST API base URL, including the version prefix.
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
# Socket.IO endpoint for realtime messaging and notifications.
NEXT_PUBLIC_WS_URL=ws://localhost:4000/realtime
# "local" = preview zustand store; "api" = production API (see docs/ARCHITECTURE.md §9).
NEXT_PUBLIC_DATA_SOURCE=local
# Shows the preview banner and demo-account switcher. Must be false in production.
NEXT_PUBLIC_PREVIEW_MODE=true
# Server-side API base URL used by React Server Components (may be a private VPC URL).
API_INTERNAL_URL=http://localhost:4000/v1
# Shared secret for POST /api/revalidate (CMS and tutor-profile cache tags).
REVALIDATE_SECRET=

# ── API runtime (NestJS on AWS) ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public API origin (webhook URLs, links in emails).
API_BASE_URL=http://localhost:4000
# Comma-separated origins allowed by CORS and the Origin/Referer CSRF check.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Default time zone for users who have not set one.
DEFAULT_TIMEZONE=America/New_York
LOG_LEVEL=info

# ── Database (PostgreSQL 15+ via Prisma) ─────────────────────────────────────
# Pooled connection (RDS Proxy / PgBouncer) used by the app.
DATABASE_URL=postgresql://tutorlink:tutorlink@localhost:5432/tutorlink?schema=public
# Direct connection used by `prisma migrate`.
DIRECT_DATABASE_URL=postgresql://tutorlink:tutorlink@localhost:5432/tutorlink?schema=public
# Optional read replica for search sync and reporting.
DATABASE_READ_REPLICA_URL=

# ── Redis (rate limits, BullMQ queues, idempotency locks, Socket.IO adapter, caches) ──
REDIS_URL=redis://localhost:6379
# Prefix so several environments can share one Redis in development.
QUEUE_PREFIX=tutorlink

# ── Auth & sessions ──────────────────────────────────────────────────────────
# 32+ random bytes (base64). Signs session cookies and consent / reset tokens.
SESSION_SECRET=
# Cookie name (the __Host- prefix requires HTTPS; use a plain name for local http).
SESSION_COOKIE_NAME=__Host-tl_session
# Learner/tutor sliding session length and staff absolute session length.
SESSION_TTL_DAYS=30
STAFF_SESSION_TTL_HOURS=12
# HMAC key for hashing IP addresses in login events and audit logs (PII minimization).
IP_HASH_SECRET=
# argon2id parameters (OWASP minimum: 19456 KiB memory, 2 iterations, parallelism 1).
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1
# Issuer label shown in authenticator apps for TOTP MFA.
MFA_ISSUER=TutorLink
# Hours before email-verification, password-reset and parental-consent links expire.
EMAIL_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
PARENTAL_CONSENT_TTL_DAYS=14
# Check new passwords against the breached-password range API (true/false).
PASSWORD_BREACH_CHECK=true

# ── Encryption (KMS envelope encryption for MFA secrets, meeting passcodes, message originals) ──
AWS_KMS_KEY_ID=
# Local development fallback key (32 bytes base64). Never used when AWS_KMS_KEY_ID is set.
LOCAL_ENCRYPTION_KEY=

# ── Payments & payouts (Stripe, Stripe Connect, Stripe Billing) ──────────────
STRIPE_SECRET_KEY=
# Signing secret for /v1/webhooks/stripe (platform events).
STRIPE_WEBHOOK_SECRET=
# Signing secret for /v1/webhooks/stripe-connect (connected-account events).
STRIPE_CONNECT_WEBHOOK_SECRET=
# Where Connect onboarding returns tutors.
STRIPE_CONNECT_RETURN_URL=http://localhost:3000/dashboard/earnings?connect=done
STRIPE_CONNECT_REFRESH_URL=http://localhost:3000/dashboard/earnings?connect=retry
# Stripe Price ids for tutor plans (Professional, Premium).
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
# Publishable key for Stripe.js / Payment Element (safe for the browser).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Search (Algolia or equivalent behind SearchIndex) ────────────────────────
ALGOLIA_APP_ID=
# Server-only key used by the indexing worker.
ALGOLIA_ADMIN_API_KEY=
ALGOLIA_TUTORS_INDEX=tutors_development
# Browser-safe, search-only key restricted to the tutors index.
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=

# ── Maps & geocoding (Google Maps Platform behind GeocodingService) ──────────
# Server key: Geocoding API, IP-restricted to the API's egress addresses.
GOOGLE_MAPS_SERVER_API_KEY=
# Browser key: Places Autocomplete only, HTTP-referrer restricted.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# ── Email (Resend behind EmailService) ───────────────────────────────────────
RESEND_API_KEY=
# Signing secret for /v1/webhooks/resend (delivery, bounce, complaint).
RESEND_WEBHOOK_SECRET=
EMAIL_FROM="TutorLink <no-reply@tutorlink.example>"
EMAIL_REPLY_TO=support@tutorlink.example
# Inbox that receives /api/contact support messages.
SUPPORT_INBOX_EMAIL=support@tutorlink.example

# ── SMS (Twilio behind SmsService; also gated by the sms_notifications flag) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Twilio Verify service used to confirm phone numbers before SMS opt-in.
TWILIO_VERIFY_SERVICE_SID=

# ── Online lessons (MeetingProvider) ─────────────────────────────────────────
# "zoom" or "google_meet".
MEETING_PROVIDER=zoom
# Zoom Server-to-Server OAuth app.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Verifies x-zm-signature on /v1/webhooks/zoom.
ZOOM_WEBHOOK_SECRET_TOKEN=
# Google Meet via Calendar API (service account with domain-wide delegation), if selected.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=

# ── File storage (S3 behind FileStorage) ─────────────────────────────────────
AWS_REGION=us-east-1
# Uploads land here first and are only promoted after a clean malware scan.
S3_QUARANTINE_BUCKET=tutorlink-dev-quarantine
# Private bucket for scanned files (served only through short-lived signed URLs).
S3_UPLOADS_BUCKET=tutorlink-dev-uploads
# Public bucket/CDN origin for CMS images and avatars.
S3_PUBLIC_ASSETS_BUCKET=tutorlink-dev-public
NEXT_PUBLIC_ASSETS_BASE_URL=
# "guardduty" (GuardDuty Malware Protection for S3), "clamav" (Lambda) or "skip" (local only).
FILE_SCAN_MODE=skip
# Size caps in bytes (messages 10 MB, verification documents 15 MB).
UPLOAD_MAX_BYTES_MESSAGE=10485760
UPLOAD_MAX_BYTES_VERIFICATION=15728640
SIGNED_URL_TTL_SECONDS=300

# ── Background checks (verification kind "background") ───────────────────────
BACKGROUND_CHECK_PROVIDER=
BACKGROUND_CHECK_API_KEY=
BACKGROUND_CHECK_WEBHOOK_SECRET=

# ── Analytics (PostHog behind Analytics) ─────────────────────────────────────
# Server-side capture key.
POSTHOG_API_KEY=
# Browser project key and host (no PII is sent in event properties).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Error reporting (Sentry behind ErrorReporting) ───────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Build-time only (source-map upload). Never exposed at runtime.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Observability ────────────────────────────────────────────────────────────
# OpenTelemetry collector endpoint for traces (API, gateway, workers).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=tutorlink-api

# ── Rate limits (requests per window; see docs/ARCHITECTURE.md §7) ───────────
RATE_LIMIT_LOGIN_PER_15M=5
RATE_LIMIT_MESSAGES_PER_MIN=30
RATE_LIMIT_BOOKINGS_PER_HOUR=10
RATE_LIMIT_CONTACT_PER_10M=5

# ── Bootstrap ────────────────────────────────────────────────────────────────
# Email of the first super admin created by the seed script (must enrol MFA on first sign-in).
BOOTSTRAP_SUPER_ADMIN_EMAIL=
