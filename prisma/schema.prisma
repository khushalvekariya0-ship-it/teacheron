// ─────────────────────────────────────────────────────────────────────────────
// TutorLink — production data model (PostgreSQL 15+, Prisma ORM 6.x)
//
// Conventions
//   • ids are cuid() strings.
//   • Money is always Int cents with a `currency` column (default "usd"). Never Float/Decimal.
//   • Every timestamp is `@db.Timestamptz(6)` and stored in UTC. Calendar-only values
//     (homework due dates, availability exceptions) use `@db.Date` in the tutor's/learner's zone.
//   • Enum values mirror the string unions in src/lib/types.ts (lower_snake_case) so API DTOs map 1:1.
//     Exceptions: Grade (k, g1…g12) and Permission (users_read ⇄ "users.read") — see comments.
//   • Users are never hard-deleted: erasure = anonymize PII + set deletedAt. Financial and safety
//     records therefore use onDelete: Restrict; owned rows (tokens, prefs, drafts) Cascade.
//   • "Learner" is either a User (student account) or a Child (parent-managed profile). Tables that
//     reference a learner carry `learnerUserId` + `childId` with a CHECK that exactly one is set.
//
// Prisma 7 note: if you adopt Prisma 7, move `url`/`directUrl` to prisma.config.ts and switch the
// generator to `prisma-client` with an explicit `output`. Do not add prisma.config.ts to this repo
// root while the Next.js app type-checks **/*.ts.
//
// ── Raw SQL that Prisma cannot express (add in a hand-edited migration: `prisma migrate dev --create-only`)
//
//   CREATE EXTENSION IF NOT EXISTS btree_gist;
//
//   -- 1. No overlapping bookings per tutor (buffer baked into blockedFrom/blockedUntil at write time).
//   ALTER TABLE bookings ADD CONSTRAINT bookings_no_overlap_per_tutor
//     EXCLUDE USING gist ("tutorId" WITH =, tstzrange("blockedFrom", "blockedUntil", '[)') WITH &&)
//     WHERE (status IN ('pending', 'confirmed', 'in_progress'));
//     -- A violation raises SQLSTATE 23P01 → API returns 409 slot_unavailable.
//
//   -- 2. One non-cancelled trial per tutor + learner (also enforced in BookingsService).
//   CREATE UNIQUE INDEX bookings_one_trial_per_learner ON bookings ("tutorId", COALESCE("childId", "bookerId"))
//     WHERE type = 'trial' AND status NOT IN ('cancelled_by_student', 'cancelled_by_tutor');
//
//   -- 3. At most one open dispute per booking.
//   CREATE UNIQUE INDEX disputes_one_open_per_booking ON disputes ("bookingId")
//     WHERE status NOT IN ('resolved', 'rejected');
//
//   -- 4. At most one live subscription per tutor.
//   CREATE UNIQUE INDEX subscriptions_one_live_per_tutor ON subscriptions ("tutorId")
//     WHERE status IN ('trialing', 'active', 'past_due', 'incomplete');
//
//   -- 5. Conversations: treat NULL childId as a value (Prisma's @@unique treats NULLs as distinct).
//   --    Edit the generated index for conversations_tutorId_learnerId_childId_key to add NULLS NOT DISTINCT.
//
//   -- 6. Exactly one learner reference.
//   ALTER TABLE learning_goals ADD CONSTRAINT learning_goals_one_learner CHECK (num_nonnulls("learnerUserId", "childId") = 1);
//   ALTER TABLE progress_notes ADD CONSTRAINT progress_notes_one_learner CHECK (num_nonnulls("learnerUserId", "childId") = 1);
//   ALTER TABLE homework       ADD CONSTRAINT homework_one_learner       CHECK (num_nonnulls("learnerUserId", "childId") = 1);
//
//   -- 7. Integrity checks.
//   ALTER TABLE bookings ADD CONSTRAINT bookings_money CHECK ("priceCents" >= 0 AND "discountCents" BETWEEN 0 AND "priceCents"
//     AND "platformFeeCents" >= 0 AND "tutorEarningsCents" >= 0 AND "endAt" > "startAt");
//   ALTER TABLE requirements ADD CONSTRAINT requirements_budget CHECK ("budgetMaxCents" >= "budgetMinCents");
//   ALTER TABLE reviews ADD CONSTRAINT reviews_rating CHECK (rating BETWEEN 1 AND 5);
//   ALTER TABLE progress_notes ADD CONSTRAINT progress_notes_rating CHECK (rating IS NULL OR rating BETWEEN 1 AND 5);
//   ALTER TABLE availability_windows ADD CONSTRAINT availability_windows_range
//     CHECK ("dayOfWeek" BETWEEN 0 AND 6 AND "startMinute" >= 0 AND "endMinute" <= 1440 AND "endMinute" > "startMinute");
//   ALTER TABLE feature_flags ADD CONSTRAINT feature_flags_rollout CHECK ("rolloutPercent" BETWEEN 0 AND 100);
//   ALTER TABLE testimonials ADD CONSTRAINT testimonials_consent CHECK (status <> 'published' OR "consentGiven");
//
//   -- 8. Audit log is append-only for the application role.
//   REVOKE UPDATE, DELETE ON audit_logs FROM tutorlink_app;
//
//   Prisma does not model exclusion constraints, CHECKs or partial/expression indexes. Keep them in
//   migrations and confirm `prisma migrate diff` never proposes dropping them.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

